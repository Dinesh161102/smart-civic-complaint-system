            "body": {
              "mode": "raw",
              "raw": "{\n  \"category\": \"Streetlight\",\n  \"description\": \"There has been no street light near Gate 3 for almost a week and the road gets extremely dark.\",\n  \"location\": \"Gate 3, Central Park West & 72nd St\",\n  \"latitude\": 40.7789,\n  \"longitude\": -73.9742,\n  \"urgency\": \"Medium\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/complaints",
              "host": ["{{base_url}}"],
              "path": ["api", "complaints"]
            },
            "description": "Submits a new complaint as a Citizen."

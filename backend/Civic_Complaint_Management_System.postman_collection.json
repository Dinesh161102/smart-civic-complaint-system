  "item": [
    {
      "name": "01 - Authentication & User Management",
      "item": [
        {
          "name": "01.1 - Login Municipal Officer (Default Seed)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"JWT access token returned for Municipal Officer\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.be.a('string').that.is.not.empty;",
                  "    pm.expect(jsonData.user.role).to.eql(\"Municipal Officer\");",
                  "    pm.collectionVariables.set(\"officer_token\", jsonData.access_token);",
                  "    pm.collectionVariables.set(\"token\", jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"officer@civic.gov\",\n  \"password\": \"Officer123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates default Municipal Officer and sets officer_token collection variable."
          }
        },
        {
          "name": "01.2 - Register Citizen (Public)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Citizen user created with role Citizen\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.role).to.eql(\"Citizen\");",
                  "    pm.collectionVariables.set(\"citizen_token\", jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@civic.gov\",\n  \"password\": \"Citizen123!\",\n  \"full_name\": \"Jane Citizen\",\n  \"phone\": \"+1-555-0102\",\n  \"role\": \"Citizen\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            },
            "description": "Public registration for Citizen accounts."
          }
        },
        {
          "name": "01.3 - Login Citizen",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"JWT access token returned for Citizen\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set(\"citizen_token\", jsonData.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citizen@civic.gov\",\n  \"password\": \"Citizen123!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "description": "Authenticates Citizen user and saves token."
